<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="820.0" prefWidth="430.0" style="-fx-background-color: #f8f6fb;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AddGameController">

    <top>
        <VBox alignment="CENTER" prefHeight="135.0"
              style="-fx-background-color: linear-gradient(to right, #5f16b5, #b51cc7);">

            <effect>
                <DropShadow blurType="GAUSSIAN" color="#5a2a7a55" offsetY="7.0" radius="18.0" />
            </effect>

            <HBox alignment="CENTER_LEFT" maxWidth="Infinity" prefWidth="430.0">
                <padding>
                    <Insets left="18.0" top="14.0" />
                </padding>

                <Button fx:id="cancelTopButton" mnemonicParsing="false" onAction="#onCancel" style="-fx-background-color: transparent;
                -fx-text-fill: #efe2fa;
                -fx-font-family: Arial;
                -fx-font-size: 14px;
                -fx-font-weight: bold;
                -fx-cursor: hand;" text="&#8249; Cancel" />
            </HBox>

            <Label style="-fx-text-fill: white;
            -fx-font-family: Arial;
            -fx-font-size: 30px;
            -fx-font-weight: bold;" text="Add Game" />

            <Label style="-fx-text-fill: #eadcf7;
            -fx-font-family: Arial;
            -fx-font-size: 13px;
            -fx-font-weight: bold;" text="GAME LIBRARY">
                <padding>
                    <Insets bottom="18.0" />
                </padding>
            </Label>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <content>
                <VBox spacing="22.0" style="-fx-background-color: transparent;">

                    <padding>
                        <Insets bottom="20.0" left="30.0" right="30.0" top="30.0" />
                    </padding>

                    <HBox alignment="CENTER" spacing="18.0">
                        <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: white;
                        -fx-background-radius: 18;
                        -fx-border-color: #eee8f2;
                        -fx-border-radius: 18;
                        -fx-border-width: 1;
                        -fx-padding: 16;">

                            <effect>
                                <DropShadow blurType="GAUSSIAN" color="#4d2e5f1a" offsetY="4.0" radius="10.0" />
                            </effect>

                            <ImageView fx:id="previewImage" fitHeight="140.0" fitWidth="110.0" preserveRatio="true" />

                            <Button fx:id="chooseImageButton" mnemonicParsing="false" onAction="#onChooseImage"
                                    style="-fx-background-color: #e9e9e9;
                            -fx-background-radius: 8;
                            -fx-font-family: Arial;
                            -fx-font-size: 12px;
                            -fx-font-weight: bold;
                            -fx-cursor: hand;" text="Choose Cover Image" />

                            <Label fx:id="imageFileLabel" style="-fx-text-fill: #9169a5;
                            -fx-font-family: Arial;
                            -fx-font-size: 11px;" text="No image selected" wrapText="true" />
                        </VBox>
                    </HBox>

                    <VBox spacing="6.0">
                        <Label style="-fx-text-fill: #808080;
                        -fx-font-family: Arial;
                        -fx-font-size: 13px;
                        -fx-font-weight: bold;" text="TITLE" />

                        <TextField fx:id="titleField" promptText="Add Title" style="-fx-background-color: #f3f0f7;
                        -fx-background-radius: 10;
                        -fx-border-color: #e3daea;
                        -fx-border-radius: 10;
                        -fx-font-family: Arial;
                        -fx-font-size: 15px;
                        -fx-padding: 10;" />
                    </VBox>

                    <VBox spacing="6.0">
                        <Label style="-fx-text-fill: #808080;
                        -fx-font-family: Arial;
                        -fx-font-size: 13px;
                        -fx-font-weight: bold;" text="PLATFORM" />

                        <ComboBox fx:id="platformCombo" editable="true" maxWidth="Infinity" promptText="Select Platform"
                                  style="-fx-background-color: #f3f0f7;
                        -fx-background-radius: 10;
                        -fx-border-color: #e3daea;
                        -fx-border-radius: 10;
                        -fx-font-family: Arial;
                        -fx-font-size: 15px;" />
                    </VBox>

                    <VBox spacing="6.0">
                        <Label style="-fx-text-fill: #808080;
                        -fx-font-family: Arial;
                        -fx-font-size: 13px;
                        -fx-font-weight: bold;" text="GENRE" />

                        <ComboBox fx:id="genreCombo" editable="true" maxWidth="Infinity" promptText="Select Genre"
                                  style="-fx-background-color: #f3f0f7;
                        -fx-background-radius: 10;
                        -fx-border-color: #e3daea;
                        -fx-border-radius: 10;
                        -fx-font-family: Arial;
                        -fx-font-size: 15px;" />
                    </VBox>

                    <VBox spacing="6.0">
                        <Label style="-fx-text-fill: #808080;
                        -fx-font-family: Arial;
                        -fx-font-size: 13px;
                        -fx-font-weight: bold;" text="HOURS PLAYED" />

                        <TextField fx:id="hoursField" promptText="0" style="-fx-background-color: #f3f0f7;
                        -fx-background-radius: 10;
                        -fx-border-color: #e3daea;
                        -fx-border-radius: 10;
                        -fx-font-family: Arial;
                        -fx-font-size: 15px;
                        -fx-padding: 10;" />
                    </VBox>

                    <VBox spacing="6.0">
                        <Label style="-fx-text-fill: #808080;
                        -fx-font-family: Arial;
                        -fx-font-size: 13px;
                        -fx-font-weight: bold;" text="DESCRIPTION" />

                        <TextArea fx:id="descriptionField" prefRowCount="4" promptText="Add a description..."
                                  wrapText="true" style="-fx-background-color: #f3f0f7;
                        -fx-background-radius: 10;
                        -fx-border-color: #e3daea;
                        -fx-border-radius: 10;
                        -fx-font-family: Arial;
                        -fx-font-size: 15px;" />
                    </VBox>

                    <Label fx:id="errorLabel" managed="false" style="-fx-text-fill: #c0392b;
                    -fx-font-family: Arial;
                    -fx-font-size: 12px;
                    -fx-font-weight: bold;" visible="false" wrapText="true" />

                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <VBox alignment="CENTER" spacing="12.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="26.0" left="30.0" right="30.0" top="14.0" />
            </padding>

            <Button fx:id="doneButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#onDone" prefHeight="52.0"
                    style="-fx-background-color: linear-gradient(to right, #65159a, #a122b5);
            -fx-background-radius: 16;
            -fx-text-fill: white;
            -fx-font-family: Arial;
            -fx-font-size: 17px;
            -fx-font-weight: bold;
            -fx-cursor: hand;" text="Done">

                <effect>
                    <DropShadow blurType="GAUSSIAN" color="#6e1d943f" offsetY="5.0" radius="13.0" />
                </effect>
            </Button>
        </VBox>
    </bottom>

</BorderPane>
