<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="820.0" prefWidth="430.0" style="-fx-background-color: #f8f6fb;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.HomeController">

    <top>
        <VBox alignment="CENTER" prefHeight="115.0" prefWidth="247.0" style="-fx-background-color: linear-gradient(to right, #55149a, #a020b5);
        -fx-background-radius: 0 0 32 32;">

            <effect>
                <DropShadow blurType="GAUSSIAN" color="#5a2a7a55" offsetY="7.0" radius="18.0" />
            </effect>

            <padding>
                <Insets bottom="32.0" left="20.0" right="20.0" top="40.0" />
            </padding>

            <Label prefHeight="81.0" prefWidth="253.0" style="-fx-text-fill: white;
            -fx-font-family: Arial;
            -fx-font-size: 37px;
            -fx-font-weight: bold;" text="Screen Report">
            <cursor>
               <Cursor fx:constant="DEFAULT" />
            </cursor></Label>
        </VBox>
    </top>

    <center>
        <VBox spacing="28.0">

            <padding>
                <Insets bottom="25.0" left="24.0" right="24.0" top="34.0" />
            </padding>

            <Label prefHeight="27.0" prefWidth="174.0" style="-fx-text-fill: #24142f;
            -fx-font-family: Arial;
            -fx-font-size: 24px;
            -fx-font-weight: bold;" text="Your Activity">
                <font>
                    <Font name="Arial Black" size="13.0" />
                </font></Label>

            <HBox alignment="CENTER" prefHeight="418.0" prefWidth="382.0" spacing="18.0">

                <VBox alignment="CENTER" prefHeight="365.0" prefWidth="180.0" spacing="12.0" style="-fx-background-color: white;
                -fx-background-radius: 22;
                -fx-border-color: #eee8f2;
                -fx-border-radius: 22;
                -fx-border-width: 1;
                -fx-padding: 22;">

                    <effect>
                        <DropShadow blurType="GAUSSIAN" color="#4d2e5f22" offsetY="5.0" radius="15.0" />
                    </effect>

                    <Region VBox.vgrow="ALWAYS" />

                    <Label style="-fx-text-fill: #9169a5;
                    -fx-font-family: Arial;
                    -fx-font-size: 12px;
                    -fx-font-weight: bold;" text="GAME LIBRARY" />

                    <Label fx:id="totalGamesLabel" style="-fx-text-fill: #6816a0;
                    -fx-font-family: Arial;
                    -fx-font-size: 39px;
                    -fx-font-weight: bold;" text="0" />

                    <Label style="-fx-text-fill: #716677;
                    -fx-font-family: Arial;
                    -fx-font-size: 15px;" text="Total games" />

                    <Region VBox.vgrow="ALWAYS" />
                </VBox>

                <VBox alignment="CENTER" prefHeight="365.0" prefWidth="180.0" spacing="12.0" style="-fx-background-color: white;
                -fx-background-radius: 22;
                -fx-border-color: #eee8f2;
                -fx-border-radius: 22;
                -fx-border-width: 1;
                -fx-padding: 22;">

                    <effect>
                        <DropShadow blurType="GAUSSIAN" color="#4d2e5f22" offsetY="5.0" radius="15.0" />
                    </effect>

                    <Region VBox.vgrow="ALWAYS" />

                    <Label style="-fx-text-fill: #9169a5;
                    -fx-font-family: Arial;
                    -fx-font-size: 12px;
                    -fx-font-weight: bold;" text="PLAY TIME" />

                    <Label fx:id="totalHoursLabel" style="-fx-text-fill: #6816a0;
                    -fx-font-family: Arial;
                    -fx-font-size: 39px;
                    -fx-font-weight: bold;" text="0" />

                    <Label style="-fx-text-fill: #716677;
                    -fx-font-family: Arial;
                    -fx-font-size: 15px;" text="Hours played" />

                    <Region VBox.vgrow="ALWAYS" />
                </VBox>
            </HBox>

            <Region VBox.vgrow="ALWAYS" />

            <Button fx:id="gameLibraryButton" maxWidth="Infinity" onAction="#openGameLibrary" prefHeight="54.0" style="-fx-background-color: linear-gradient(to right, #65159a, #a122b5);
            -fx-background-radius: 18;
            -fx-text-fill: white;
            -fx-font-family: Arial;
            -fx-font-size: 18px;
            -fx-font-weight: bold;
            -fx-cursor: hand;" text="Open Game Library">

                <effect>
                    <DropShadow blurType="GAUSSIAN" color="#6e1d943f" offsetY="5.0" radius="13.0" />
                </effect>
            </Button>

            <Label alignment="CENTER" maxWidth="Infinity" style="-fx-text-fill: #aa9daf;
            -fx-font-family: Arial;
            -fx-font-size: 11px;
            -fx-font-weight: bold;" text="SCREEN REPORT" />
        </VBox>
    </center>

</BorderPane>
