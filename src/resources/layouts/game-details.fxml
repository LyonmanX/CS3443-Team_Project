<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="800.0" prefWidth="480.0" style="-fx-background-color: white;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.GameDetailsController">

    <top>
        <VBox alignment="CENTER" prefHeight="135.0"
              style="-fx-background-color: linear-gradient(to right, #5f16b5, #b51cc7);">

            <Label style="-fx-font-size: 38px;
            -fx-font-weight: bold;
            -fx-text-fill: white;"
                   text="Game Details" />

        </VBox>
    </top>

    <center>

        <VBox spacing="28.0">

            <padding>
                <Insets bottom="30.0" left="35.0" right="35.0" top="45.0" />
            </padding>

            <Label fx:id="titleLabel" maxWidth="410.0" style="-fx-font-size: 30px;
            -fx-font-weight: bold;
            -fx-text-fill: black;"
                   text="Game Title"
                   wrapText="true" />

            <HBox alignment="TOP_LEFT" spacing="25.0">

                <VBox spacing="18.0" HBox.hgrow="ALWAYS">

                    <VBox spacing="4.0">

                        <Label style="-fx-font-size: 13px;
                        -fx-font-weight: bold;
                        -fx-text-fill: #808080;"
                               text="PLATFORM" />

                        <Label fx:id="platformLabel" style="-fx-font-size: 18px;
                        -fx-text-fill: black;"
                               text="-"
                               wrapText="true" />

                    </VBox>

                    <VBox spacing="4.0">

                        <Label style="-fx-font-size: 13px;
                        -fx-font-weight: bold;
                        -fx-text-fill: #808080;" text="GENRE" />

                        <Label fx:id="genreLabel" style="-fx-font-size: 18px;
                        -fx-text-fill: black;"
                               text="-"
                               wrapText="true" />

                    </VBox>

                    <VBox spacing="4.0">

                        <Label style="-fx-font-size: 13px;
                        -fx-font-weight: bold;
                        -fx-text-fill: #808080;"
                               text="HOURS PLAYED" />

                        <Label fx:id="hoursPlayedLabel" style="-fx-font-size: 18px;
                        -fx-text-fill: black;"
                               text="0" />

                    </VBox>

                    <VBox spacing="4.0">

                        <Label style="-fx-font-size: 13px;
                        -fx-font-weight: bold;
                        -fx-text-fill: #808080;"
                               text="STATUS" />

                        <Label fx:id="statusLabel" style="-fx-font-size: 18px;
                        -fx-text-fill: black;"
                               text="-"
                               wrapText="true" />

                    </VBox>

                </VBox>

                <ImageView fx:id="gameImageView" fitHeight="210.0" fitWidth="150.0" preserveRatio="true" />

            </HBox>

            <Label style="-fx-font-size: 14px;
            -fx-font-weight: bold;
            -fx-text-fill: #808080;"
                   text="DESCRIPTION" />

            <Label fx:id="descriptionLabel" maxWidth="410.0" style="-fx-font-size: 17px;
            -fx-text-fill: #555555;"
                   text=""
                   wrapText="true" />

            <Region VBox.vgrow="ALWAYS" />

            <HBox alignment="CENTER" spacing="14.0">

                <Button fx:id="gameLibraryButton" onAction="#openGameLibrary" prefHeight="45.0" prefWidth="130.0"
                        style="-fx-background-color: #e9e9e9;
                -fx-background-radius: 8;
                -fx-font-size: 14px;
                -fx-font-weight: bold;"
                        text="Game Library" />

                <Button fx:id="editButton" onAction="#openEdit" prefHeight="45.0" prefWidth="130.0"
                        style="-fx-background-color: #f1e4fb;
                -fx-text-fill: #55149a;
                -fx-background-radius: 8;
                -fx-font-size: 14px;
                -fx-font-weight: bold;"
                        text="Edit" />

                <Button fx:id="timerButton" onAction="#openTimer" prefHeight="45.0" prefWidth="130.0"
                        style="-fx-background-color: linear-gradient(to right, #5f16b5, #b51cc7);
                -fx-text-fill: white;
                -fx-background-radius: 8;
                -fx-font-size: 14px;
                -fx-font-weight: bold;"
                        text="Timer" />

            </HBox>

        </VBox>

    </center>

</BorderPane>
